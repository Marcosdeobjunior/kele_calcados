# Número da dona no WhatsApp, só dígitos com DDI + DDD (protótipo: fictício)
VITE_WHATSAPP_NUMBER=5511900000000
# Mostra a opção "Retirar na loja" no checkout
VITE_PICKUP_ENABLED=true
# Paleta: noir (Noir & ouro, padrão) ou marfim
VITE_PALETTE=noir

# Supabase (Auth + Postgres + Storage). Sem estas variáveis o app roda em
# modo demonstração: produtos no localStorage e login de teste da dona.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
